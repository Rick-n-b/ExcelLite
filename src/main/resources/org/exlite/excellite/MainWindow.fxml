<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<SplitPane fx:id="splitPane" dividerPositions="0.5" minHeight="600.0" minWidth="900.0" orientation="VERTICAL" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.exlite.excellite.AppController">
  <items>
    <AnchorPane fx:id="topMenu" maxHeight="97.0" minHeight="97.0" minWidth="898.0" prefHeight="97.0" prefWidth="898.0" SplitPane.resizableWithParent="false">
         <children>
            <TextField fx:id="positionText" layoutX="14.0" layoutY="34.0" prefHeight="25.0" prefWidth="50.0">
               <font>
                  <Font size="14.0" />
               </font>
            </TextField>
            <TextField fx:id="innerText" layoutX="87.0" layoutY="34.0" prefHeight="30.0" prefWidth="200.0">
               <font>
                  <Font size="14.0" />
               </font>
            </TextField>
            <Button fx:id="constant" layoutX="319.0" layoutY="34.0" mnemonicParsing="false" onAction="#constantPressed" text="e" textAlignment="CENTER">
               <contextMenu>
                  <ContextMenu>
                    <items>
                      <MenuItem mnemonicParsing="false" text="e" />
                    </items>
                  </ContextMenu>
               </contextMenu>
               <font>
                  <Font name="System Italic" size="14.0" />
               </font>
            </Button>
            <Button fx:id="addTableButton" layoutX="537.0" layoutY="52.0" mnemonicParsing="false" onAction="#addTable" prefWidth="100.0" text="Add Table" />
            <TextField fx:id="tableRenameText" layoutX="599.0" layoutY="23.0" prefHeight="25.0" prefWidth="240.0" promptText="Table" />
            <Label layoutX="537.0" layoutY="25.0" text="Rename:">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            <Button fx:id="renameTableButton" layoutX="649.0" layoutY="52.0" mnemonicParsing="false" onAction="#renameTable" prefWidth="80.0" text="Rename" />
            <Button fx:id="deleteTableButton" layoutX="739.0" layoutY="52.0" mnemonicParsing="false" onAction="#deleteTable" prefWidth="100.0" text="Delete current" />
         </children></AnchorPane>
      <TabPane fx:id="tabPane" prefHeight="200.0" prefWidth="200.0" tabClosingPolicy="UNAVAILABLE" />
  </items>
</SplitPane>
