<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<SplitPane fx:id="splitPane" dividerPositions="0.5" minHeight="600.0" minWidth="900.0" orientation="VERTICAL" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.exlite.excellite.AppController">
  <items>
    <AnchorPane fx:id="topMenu" maxHeight="97.0" minHeight="97.0" minWidth="898.0" prefHeight="97.0" prefWidth="898.0" SplitPane.resizableWithParent="false">
         <children>
            <TextField fx:id="positionText" layoutX="14.0" layoutY="34.0" prefHeight="25.0" prefWidth="50.0">
               <font>
                  <Font size="14.0" />
               </font>
            </TextField>
            <TextField fx:id="innerText" layoutX="87.0" layoutY="34.0" prefHeight="30.0" prefWidth="200.0">
               <font>
                  <Font size="14.0" />
               </font>
            </TextField>
            <Button fx:id="addTableButton" layoutX="537.0" layoutY="52.0" mnemonicParsing="false" onAction="#addTable" prefWidth="100.0" text="Add Table" textAlignment="CENTER" />
            <TextField fx:id="tableRenameText" layoutX="609.0" layoutY="19.0" prefHeight="25.0" prefWidth="240.0" promptText="Table">
               <font>
                  <Font size="14.0" />
               </font></TextField>
            <Label layoutX="537.0" layoutY="24.0" text="Rename:">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            <Button fx:id="renameTableButton" layoutX="655.0" layoutY="52.0" mnemonicParsing="false" onAction="#renameTable" prefWidth="80.0" text="Rename" textAlignment="CENTER" />
            <Button fx:id="deleteTableButton" layoutX="749.0" layoutY="52.0" mnemonicParsing="false" onAction="#deleteTable" prefWidth="100.0" text="Delete current" textAlignment="CENTER" />
            <Button fx:id="searchButton" layoutX="368.0" layoutY="52.0" mnemonicParsing="false" onAction="#search" prefWidth="100.0" text="Search" textAlignment="CENTER" />
            <TextField fx:id="searchText" layoutX="318.0" layoutY="19.0" prefHeight="30.0" prefWidth="200.0">
               <font>
                  <Font size="14.0" />
               </font>
            </TextField>
         </children></AnchorPane>
      <TabPane fx:id="tabPane" prefHeight="200.0" prefWidth="200.0" tabClosingPolicy="UNAVAILABLE" />
  </items>
</SplitPane>
